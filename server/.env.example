# FinPilot Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database (Local MongoDB or MongoDB Atlas connection string)
# Example Atlas format: mongodb+srv://username:password@cluster.mongodb.net/finpilot?appName=FinPilotCluster
MONGODB_URI=mongodb://127.0.0.1:27017/finpilot

# Authentication & Sessions
SESSION_SECRET=finpilot-super-secure-session-secret-change-in-production-2026
JWT_SECRET=finpilot-super-secure-jwt-secret-change-in-production-2026
COOKIE_DOMAIN=localhost

# Security & CORS
CLIENT_ORIGIN=http://localhost:5173

# Razorpay (Test Mode Only)
RAZORPAY_KEY_ID=rzp_test_mock_finpilot_key
RAZORPAY_KEY_SECRET=mock_secret_finpilot_2026
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret_2026
ENABLE_MOCK_PAYMENTS=true

# AI Provider (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
AI_API_KEY=
AI_MODEL_NAME=gemini-flash-lite-latest

# Email / Notifications (Logging Mock Adapter by default)
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@finpilot.app
