# FinPilot Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/finpilot

# Authentication & Sessions
SESSION_SECRET=finpilot-super-secure-session-secret-change-in-production-2026
JWT_SECRET=finpilot-super-secure-jwt-secret-change-in-production-2026
COOKIE_DOMAIN=localhost

# Security & CORS
CLIENT_ORIGIN=http://localhost:5173

# Razorpay (Test Mode Only)
RAZORPAY_KEY_ID=rzp_test_mock_finpilot_key
RAZORPAY_KEY_SECRET=mock_secret_finpilot_2026
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret_2026
ENABLE_MOCK_PAYMENTS=true

# AI Provider (Initially Mock Mode)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Email / Notifications (Logging Mock Adapter by default)
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@finpilot.app
